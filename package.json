{
  "name": "react-blog-demo",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "node": "22.22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging --outDir dist/staging",
    "build:production": "tsc -b && vite build --mode production --outDir dist/production",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:staging": "vite preview --outDir dist/staging --port 4174 --strictPort",
    "preview:production": "vite preview --outDir dist/production --port 4175 --strictPort"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
